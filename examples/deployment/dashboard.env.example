# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
# Store this file outside the repository, readable only by the service account.
DASHBOARD_ACCESS_TOKEN=
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787
# Add your exact HTTPS hostname when configuring a reverse proxy or tunnel.
DASHBOARD_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Set true when the browser accesses the service over HTTPS.
DASHBOARD_SECURE_COOKIE=false
