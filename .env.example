# Local OpenSandbox server. Copy this file to .env and load it in the shell
# before starting the harness (for example: set -a; source .env; set +a).

SANDBOX_DOMAIN=localhost:8080
SANDBOX_PROTOCOL=http
SANDBOX_USE_SERVER_PROXY=true
# Leave empty when the local server has authentication disabled.
SANDBOX_API_KEY=
# Budget between SSE chunks. Agents can stay quiet for a long time.
SANDBOX_REQUEST_TIMEOUT_SECONDS=600

# Used only by tasks with agent.kind: coding-cli.
# Claude: at least one of the two.
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=

# Codex.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
