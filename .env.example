# Server OpenSandbox locale. Copia questo file in .env e caricalo nella shell
# prima di lanciare l'harness (per esempio: set -a; source .env; set +a).

SANDBOX_DOMAIN=localhost:8080
SANDBOX_PROTOCOL=http
SANDBOX_USE_SERVER_PROXY=true
# Lascia vuoto se il server locale ha l'autenticazione disabilitata.
SANDBOX_API_KEY=
# Budget fra un chunk SSE e il successivo. Gli agenti possono restare in silenzio a lungo.
SANDBOX_REQUEST_TIMEOUT_SECONDS=600

# Servono solo ai task con agent.kind: coding-cli.
# Claude: almeno una delle due.
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=

# Codex.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
